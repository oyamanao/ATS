            "flutterMode": "debug",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=ATS_BACKEND_URL=http://192.168.10.50:3000",
                "--dart-define=ATS_SUPABASE_URL=http://192.168.10.50:8000"
            ]
        },
        {
            "name": "Flutter: Debug (Android Emulator Localhost Bridge 10.0.2.2)",
