{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter: Debug (Android Device/Emulator)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "program": "lib/main.dart"
        },
        {
