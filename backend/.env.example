# Copy this file to .env and fill in the values before running the backend directly.
# When running through Docker Compose from the project root, keep the defaults below
# and set APP_PUBLIC_URL to your server's public address (for example: http://203.0.113.10:3000).

# Supabase service URL. Inside Docker this should remain the internal gateway service name.
SUPABASE_URL=http://gateway:8000
SUPABASE_SERVICE_ROLE_KEY=super-secret-jwt-token-with-at-least-32-chars-long

# University domain lock
ALLOWED_EMAIL_DOMAIN=@iiitdwd.ac.in

# TOTP shared secret (base32 encoded) — must match what the teacher's QR screen uses
SHARED_CLASS_SECRET=KVKXG2LEMYFA====

# TOTP token validity window (seconds)
TOTP_INTERVAL=10

# Server binding
PORT=3000
HOST=0.0.0.0

# Public app URL used for external callback links
APP_PUBLIC_URL=http://localhost:3000
