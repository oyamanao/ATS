# Copy this file to .env on the remote server and set the values for your deployment.
# The project is designed so that the backend is exposed on port 3000 (and optional gateway on port 8000).

APP_PUBLIC_URL=http://localhost:3000
APP_PORT=3000

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Use a strong randomly generated string for production
JWT_SECRET=super-secret-jwt-token-with-at-least-32-chars-long
SUPABASE_SERVICE_ROLE_KEY=super-secret-jwt-token-with-at-least-32-chars-long

# Inside Docker Compose, gateway:8000 is the internal network address.
SUPABASE_URL=http://gateway:8000

ALLOWED_EMAIL_DOMAIN=@iiitdwd.ac.in
SHARED_CLASS_SECRET=KVKXG2LEMYFA====
TOTP_INTERVAL=10

GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/v1/callback
