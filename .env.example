# =============================================================================
# Cheat-Proof Indoor Attendance System (ATS) — Environment Variables
# Copy this file to .env before starting the Docker Compose stack.
# =============================================================================

# Public host URL where the backend and teacher projector are accessed
APP_PUBLIC_URL=http://localhost:3000
APP_PORT=3000

# Port for unified Supabase Auth/DB Gateway (PostgREST + GoTrue)
GATEWAY_PORT=8000
POSTGRES_PORT=127.0.0.1:5432

# Database Credentials
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Cryptographic Keys (HS256 signed JWT tokens for Supabase)
JWT_SECRET=super-secret-jwt-token-with-at-least-32-chars-long
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzAwMDAwMDAwLCJleHAiOjIwNTAwMDAwMDB9.8iej_KelMbImwdSqAjKpH7b0s4P-ul6qvATIC3uOqKc
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3MDAwMDAwMDAsImV4cCI6MjA1MDAwMDAwMH0.qo7BEOW9yB2xFpo8S-OzzMEqY3qHvGFakU2yRG-5Rtc

# Supabase URL for backend internal network communication
SUPABASE_URL=http://gateway:8000

# University Domain Lock
ALLOWED_EMAIL_DOMAIN=@iiitdwd.ac.in

# Shared Dynamic TOTP Secret (Base32 encoded)
SHARED_CLASS_SECRET=KVKXG2LEMYFA====
TOTP_INTERVAL=10

# GoTrue Authentication Settings
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_API_EXTERNAL_URL=http://localhost:8000/auth/v1

# Optional Google OAuth Settings
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/v1/callback
